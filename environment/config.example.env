# Copy to /opt/browser-meme/secrets/research.env inside the research WSL distro.
# Do not send credentials in chat or commit the local file.
HF_TOKEN=
OPENAI_API_KEY=
# Optional: uncomment only when using a custom API endpoint.
# OPENAI_BASE_URL=https://your-api-endpoint/v1
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
GEMINI_API_KEY=

# WorkArena uses its authorized ServiceNow instance pool. Do not set a mirror
# endpoint for Hugging Face when sending an access token.
HF_ENDPOINT=https://huggingface.co

# Four official WebChoreArena sites; the clean speed-test GitLab uses port 8929.
WA_SHOPPING=http://127.0.0.1:7770
WA_SHOPPING_ADMIN=http://127.0.0.1:7780/admin
WA_REDDIT=http://127.0.0.1:9999
WA_GITLAB=http://127.0.0.1:8023
WA_HOMEPAGE=http://127.0.0.1:4399
# Required by the inherited configuration interface, unused by the four-site
# WebChoreArena tasks. These two services are not part of this deployment.
WA_WIKIPEDIA=http://127.0.0.1:8888
WA_MAP=http://127.0.0.1:3000
CALC_AVAILABLE=False
